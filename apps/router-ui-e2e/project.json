{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "//": [
    "`dependsOn` under `e2e` is a task edge — it builds the console and the API first,",
    "but `nx affected` does not read it, and no spec here imports from either app. So a",
    "console-only PR used to leave this whole suite unrun while the job still reported",
    "green (SUP-414). These are the project edges that make `affected` see it."
  ],
  "implicitDependencies": [
    "@confidential-router/router-ui",
    "@confidential-router/router-api"
  ],
  "targets": {
    "e2e": {
      "dependsOn": [
        "@confidential-router/router-ui:build",
        "@confidential-router/router-api:build"
      ]
    },
    "e2e-image": {
      "command": "playwright test --config playwright.image.config.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": false
    },
    "e2e-secure": {
      "command": "playwright test --config playwright.secure.config.ts",
      "options": {
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "@confidential-router/router-ui:build",
        "@confidential-router/router-api:build",
        "gatekeeper:build",
        "gatekeeper:build-teststand"
      ],
      "cache": false
    },
    "typecheck": {
      "command": "tsc -p tsconfig.json",
      "options": {
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["default", "^default", "{workspaceRoot}/tsconfig.base.json"]
    }
  }
}
