{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declarationMap": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    // `playwright.config.ts` imports `src/origins.ts` by its real name: Nx
    // loads that file under Node's type stripping, which resolves the
    // specifier literally and cannot invent an extension.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "playwright.image.config.ts",
    "src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../../tools/demo"
    }
  ]
}
