# Copy to `.env.local` for local development.
#
# These are read by the server on every request and written into the document it
# serves, so they are browser-visible — never put a secret in this file. They are
# not build-time: changing one needs a restart, never a rebuild.

# router-api's origin. Better Auth is mounted at <origin>/auth (ADR-004), and
# GraphQL defaults to <origin>/graphql. Usually the only one you need to set.
ROUTER_UI_API_ORIGIN=http://127.0.0.1:3000

# Only for a deployment that serves GraphQL somewhere other than <origin>/graphql.
# ROUTER_UI_GRAPHQL_HTTP=http://127.0.0.1:3000/graphql

# Where Better Auth returns the browser after a social or magic-link sign-in.
# ROUTER_UI_AUTH_CALLBACK_URL=/
