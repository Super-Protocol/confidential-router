# Copy to `.env.local` for local development. Every value here is inlined into
# the client bundle at build time — never put a secret in this file.

# router-api's GraphQL endpoint.
NEXT_PUBLIC_GRAPHQL_HTTP=http://127.0.0.1:3000/graphql

# router-api's origin. Better Auth is mounted at <origin>/auth (ADR-004).
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:3000

# Where Better Auth returns the browser after a social or magic-link sign-in.
NEXT_PUBLIC_AUTH_CALLBACK_URL=/
