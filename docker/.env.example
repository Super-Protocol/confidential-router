# Copy to `docker/.env` (git-ignored) and edit. Docker Compose reads that file
# automatically for `docker/docker-compose.yml` and `docker/docker-compose.dev.yml`.
#
#   cp docker/.env.example docker/.env
#
# Every value below is the default the compose file already uses, so an untouched
# copy changes nothing. Nothing here is inlined into the console bundle except
# the two URLs marked as build-time.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=router
POSTGRES_PASSWORD=router
POSTGRES_DB=router
# Only docker-compose.dev.yml publishes PostgreSQL to the host.
POSTGRES_PORT=5432

# --- Where the stack is reachable -------------------------------------------
# Host ports.
ROUTER_API_PORT=3000
ROUTER_UI_PORT=3001
# `--profile demo` only.
MOCK_LITELLM_PORT=4000
EVIDENCE_PUBLISHER_PORT=8081

# Public origins. ROUTER_API_PUBLIC_URL is *build-time* for the console —
# `NEXT_PUBLIC_*` is inlined by `next build`, so changing it means
# `docker compose build ui`, not just a restart (apps/router-ui/README.md).
# It is also what the API signs magic links and OAuth callbacks against.
ROUTER_API_PUBLIC_URL=http://localhost:3000
ROUTER_UI_PUBLIC_URL=http://localhost:3001

# --- router-api -------------------------------------------------------------
# Signs session cookies and magic-link tokens; at least 32 characters. Rotating
# it invalidates every session. Generate one with:
#   openssl rand -hex 32
CR_API_AUTH__SECRET=demo-secret-not-for-anything-real-32

# fatal | error | warn | info | debug | trace | silent
CR_API_LOG__LEVEL=info

# --- Images -----------------------------------------------------------------
# Set these to the published tags and run `docker compose up --no-build` to run
# the release images instead of building from this clone.
#   ROUTER_API_IMAGE=ghcr.io/super-protocol/confidential-router/router-api:latest
#   ROUTER_UI_IMAGE=ghcr.io/super-protocol/confidential-router/router-ui:latest
# The published console image is built against http://localhost:3000; deploying
# on another origin means building your own.
ROUTER_API_IMAGE=confidential-router/router-api:local
ROUTER_UI_IMAGE=confidential-router/router-ui:local

# --- Things a deployment sets and the demo does not -------------------------
# Uncomment and add these to the `api` service's `environment` to exercise them.
#
# OAuth sign-in (ADR-004). The callback is <ROUTER_API_PUBLIC_URL>/auth/callback/<provider>.
#   CR_API_AUTH__GITHUB__CLIENT_ID=
#   CR_API_AUTH__GITHUB__CLIENT_SECRET=
#   CR_API_AUTH__GOOGLE__CLIENT_ID=
#   CR_API_AUTH__GOOGLE__CLIENT_SECRET=
#
# Real magic-link delivery. Required once NODE_ENV=production: the console
# mailer, which prints the link to the log, is refused there.
#   CR_API_AUTH__MAGIC_LINK__MAILER=resend
#   CR_API_AUTH__MAGIC_LINK__RESEND_API_KEY=
#   CR_API_AUTH__MAGIC_LINK__FROM=no-reply@example.com
#
# Credits (ADR-005). Without these the manual payment provider stands in, and
# that provider is refused in production.
#   CR_API_BILLING__STRIPE__SECRET_KEY=
#   CR_API_BILLING__STRIPE__WEBHOOK_SECRET=
