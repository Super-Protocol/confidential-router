{
  "name": "@confidential-router/nx-biome",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@confidential-router/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "libs/nx-biome/dist",
          "main": "libs/nx-biome/src/index.ts",
          "tsConfig": "libs/nx-biome/tsconfig.lib.json",
          "rootDir": "libs/nx-biome/src",
          "generatePackageJson": false
        }
      }
    }
  },
  "dependencies": {
    "@nx/devkit": "23.1.2",
    "tslib": "^2.8.1"
  }
}
