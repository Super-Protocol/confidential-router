{
  "name": "@confidential-router/source",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "prepare": "tsc -p libs/nx-biome/tsconfig.lib.json",
    "build": "pnpm nx run-many -t build",
    "test": "pnpm nx run-many -t test",
    "lint": "pnpm nx run-many -t lint",
    "lint-fix": "pnpm nx run-many -t lint-fix",
    "typecheck": "pnpm nx run-many -t typecheck",
    "verify": "pnpm nx run-many -t lint typecheck build test",
    "format": "pnpm exec biome format --write .",
    "format:check": "pnpm exec biome format .",
    "gatekeeper:build": "pnpm nx run gatekeeper:build",
    "gatekeeper:test": "pnpm nx run gatekeeper:test",
    "gatekeeper:serve": "pnpm nx run gatekeeper:serve",
    "api:serve": "pnpm nx run @confidential-router/router-api:serve",
    "api:test": "pnpm nx run @confidential-router/router-api:test",
    "api:migrate": "pnpm nx run @confidential-router/router-api:migrate",
    "ui:dev": "pnpm nx run @confidential-router/router-ui:dev --port=3001",
    "codegen": "pnpm nx run @confidential-router/router-ui:codegen",
    "dev:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f docker/docker-compose.dev.yml down",
    "graph": "pnpm nx graph",
    "show:projects": "pnpm nx show projects",
    "clean": "pnpm nx reset"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.0",
    "@confidential-router/nx-biome": "workspace:*",
    "@nx/devkit": "23.1.2",
    "@nx/docker": "23.1.2",
    "@nx/js": "23.1.2",
    "@nx/next": "23.1.2",
    "@nx/playwright": "23.1.2",
    "@nx/react": "23.1.2",
    "@nx/vite": "23.1.2",
    "@nx/vitest": "23.1.2",
    "@nx/webpack": "23.1.2",
    "@nx/workspace": "23.1.2",
    "@peculiar/webcrypto": "^1.7.1",
    "@playwright/test": "^1.62.1",
    "@swc/core": "^1.16.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.0.1",
    "next": "^16.3.3",
    "nx": "23.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "supertest": "^7.2.2",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.5.11",
    "vite": "^7.1.14",
    "vitest": "^3.2.4",
    "webpack-cli": "^7.2.3",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.24.0",
  "nx": {
    "includedScripts": []
  }
}
