{
  "name": "@confidential-router/contract-conformance",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@confidential-router/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "graphql": "^16.14.2"
  },
  "nx": {
    "targets": {
      "check": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "node tools/contract-conformance/src/main.ts"
        }
      }
    }
  }
}
