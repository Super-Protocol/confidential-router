{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "types": ["node"],
    "lib": ["es2022", "dom"],
    "emitDeclarationOnly": false,
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["vitest.config.mts", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "references": [
    {
      "path": "../mock-evidence-host/tsconfig.lib.json"
    },
    {
      "path": "../mock-litellm/tsconfig.lib.json"
    }
  ]
}
